# Generate a unique SECRET_KEY before using production mode.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me-in-production
DATABASE_URL=sqlite:///billing.db
# DATABASE_URL=postgresql://billing_user:YOUR_PASSWORD@localhost/billing
SHOP_TZ=Asia/Kolkata
SESSION_COOKIE_SECURE=false
FLASK_ENV=development
# Set production + secure cookies behind HTTPS for access from other devices.
# Set TRUST_PROXY=1 only behind a trusted reverse proxy; otherwise keep 0.
TRUST_PROXY=0

# Passkeys: use ONE stable HTTPS hostname for all shop devices.
# Fingerprint/Face ID stays on the device; the app requires device verification.
# PASSKEY_ORIGIN=https://billing.example.com
# PASSKEY_RP_ID=billing.example.com
# TRUSTED_HOSTS=billing.example.com
# Local development: http://localhost:<port> works without these settings.
# Raw HTTP LAN addresses do not support passkeys; password login stays available.
# Set this only during initial setup, or choose the owner password interactively:
# INITIAL_ADMIN_PASSWORD=choose-a-unique-password-of-at-least-12-characters
